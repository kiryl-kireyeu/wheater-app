#!/usr/bin/env sh
set -eu

PYTHON_BIN=".venv/bin/python"

if [ ! -x "$PYTHON_BIN" ]; then
  echo "Python virtual environment is missing. Run: python3 -m venv .venv && .venv/bin/python -m pip install -e '.[dev]'"
  exit 1
fi

if ! "$PYTHON_BIN" -m ruff --version >/dev/null 2>&1; then
  echo "ruff is not installed in .venv. Run: .venv/bin/python -m pip install -e '.[dev]'"
  exit 1
fi

echo "Running ruff formatter..."
"$PYTHON_BIN" -m ruff format .

echo "Running ruff linter with auto-fix..."
"$PYTHON_BIN" -m ruff check . --fix

git add -u

echo "Pre-commit checks completed."

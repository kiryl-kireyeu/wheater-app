#!/usr/bin/env sh
set -eu

PYTHON_BIN=".venv/bin/python"

if [ ! -x "$PYTHON_BIN" ]; then
  echo "Python virtual environment is missing. Run: python3 -m venv .venv && .venv/bin/python -m pip install -e '.[dev]'"
  exit 1
fi

if ! "$PYTHON_BIN" -m pytest --version >/dev/null 2>&1; then
  echo "pytest is not installed in .venv. Run: .venv/bin/python -m pip install -e '.[dev]'"
  exit 1
fi

echo "Running tests..."
"$PYTHON_BIN" -m pytest

echo "Pre-push tests completed."
